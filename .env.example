# OneClick Distill — environment configuration (copy to .env and fill in)
# Never commit real keys. Use a system credential manager in production.

# Teacher API (required only for the "synthetic data" stage)
TEACHER_BASE_URL=https://api.deepseek.com/v1
TEACHER_MODEL=deepseek-chat
TEACHER_API_KEY=sk-xxxx

# HuggingFace token (only needed for gated models)
HF_TOKEN=

# Paths to bundled tools (auto-downloaded into tools/ if missing)
LLAMA_QUANTIZE=
CONVERT_HF_TO_GGUF=

# Server
HOST=127.0.0.1
PORT=8080
